# Google AI Studio Developer API. Never commit a real key.
GOOGLE_API_KEY=
# Selected Google runtime model; credentials remain server-side.
GOOGLE_CHAT_MODEL=gemini-3.5-flash-lite
ASSET_LIVE_ENABLED=1
ASSET_GENERATION_LIMIT=500

# Active final snapshot (600 wells). Paths below are relative to the project root.
ASSET_DATASET_ROOTS=dataset/test-data/dataset
ASSET_DATASET_NAMESPACE=asset-field-test-2027-01-15
ASSET_REFERENCE_DATE=2027-01-15
ASSET_RETRIEVAL_DB=runtime/retrieval-test.sqlite
