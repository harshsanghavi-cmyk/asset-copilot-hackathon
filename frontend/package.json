    "leaflet": "1.9.4",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "rxjs": "7.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
